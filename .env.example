# SQLAlchemy URL for the User Service's OWN PostgreSQL.
# Never point this at the legacy monolith database.
DATABASE_URL=postgresql+psycopg://user_service:user_service@localhost:5433/user_service

APP_ENV=development
LOG_LEVEL=INFO
GRACEFUL_SHUTDOWN_SECONDS=20

# --- CDC consumer (app/cdc, separate process: `python -m app.cdc`) ---------
# Talks to the Kafka broker from cdc-infrastructure. localhost:9092 is its
# host-published port; inside docker-compose use kafka:9092 instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USERS_TOPIC=legacy.public.users
KAFKA_CONSUMER_GROUP=user-service-cdc
KAFKA_AUTO_OFFSET_RESET=earliest
